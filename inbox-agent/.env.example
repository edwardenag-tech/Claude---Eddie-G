# ─────────────────────────────────────────────
#  Inbox Agent — Environment Variable Template
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Azure (Outlook / Microsoft 365)
# App: "Landlord Update Agent"
AZURE_CLIENT_ID=077f47ad-e210-48dd-997f-5ca413ca735c
AZURE_TENANT_ID=255db1c7-fd44-4604-9aea-032bd2883c0d
 
# Email addresses
USER_GMAIL=edwardenag@gmail.com
USER_OUTLOOK=edward@ibproperty.com.au

# Comma-separated list of addresses to receive the morning briefing
NOTIFY_EMAILS=edwardenag@gmail.com,edward@ibproperty.com.au

# Gmail OAuth2 credentials file (downloaded from Google Cloud Console)
# See README.md for instructions on how to obtain this file
GMAIL_CREDENTIALS_PATH=gmail_credentials.json

# Auto-generated token files (created on first run — do not edit manually)
GMAIL_TOKEN_PATH=gmail_token.json
MSAL_TOKEN_CACHE_PATH=msal_token_cache.json

# Google Doc ID for the "Campaign Enquiry Reply Templates" doc — the live
# source vendor_update_agent.py and draft_agent.py read for current campaign
# status, positioning, key facts, price guide, etc. Defaults to Eddie's doc
# below if unset.
# NOTE: gmail_client.py's SCOPES now includes documents.readonly. If
# gmail_token.json was generated before this change, delete it and re-run
# `python agent.py --auth` once to re-consent with the new scope.
CAMPAIGN_DOC_ID=12gKTGiqwqgEc5iBnypfKFP79bEKThc1ltBOnIvC8Mrk

# Apple iCloud (personal calendar, via CalDAV)
# Generate an app-specific password at appleid.apple.com -- never use the main
# Apple ID password here.
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Set to "true" to also save a copy of each draft_agent.py / market_update_agent.py
# draft to Gmail Drafts. Off by default -- a Gmail copy of a reply to an IB
# Property enquiry or a market-update letter would send from Eddie's personal
# Gmail address, not his IB one.
DRAFT_GMAIL_COPIES=false

# market_update_agent.py: path to the live Dropbox "DATA BASE.xlsx" workbook.
# Defaults to its usual location under ~/Dropbox if unset.
MARKET_UPDATE_DB_PATH=/Users/you/Dropbox/Data Base/Main Data Base/DATA BASE.xlsx

# market_update_agent.py: where it records which owners have already been
# drafted, so a repeat run doesn't draft the same person twice. Defaults to
# market_update_state.json in the inbox-agent folder if unset.
MARKET_UPDATE_STATE_PATH=market_update_state.json
